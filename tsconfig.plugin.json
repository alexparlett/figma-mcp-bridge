{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "ES2017"
    ],
    "module": "None",
    "paths": {
      "../types/types.js": [
        "./types/types.ts"
      ]
    },
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "target": "ES6",
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@figma"
    ]
  },
  "composite": true,
  "exclude": [
    "node_modules",
    "server"
  ],
  "include": [
    "plugin/**/*.ts",
    "types/**/*.ts"
  ]
}