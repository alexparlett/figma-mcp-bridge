{
  "name": "figma-mcp-bridge",
  "version": "1.0.0",
  "description": "MCP server and Figma plugin for bridging Claude to Figma",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "figma-mcp-bridge": "./dist/server/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:plugin",
    "build:server": "tsc -p tsconfig.server.json",
    "build:plugin": "esbuild plugin/code.ts --bundle --outfile=dist/plugin/code.js --target=es6 --format=iife && cp plugin/ui.html dist/plugin/ && cp plugin/manifest.json dist/plugin/",
    "watch": "concurrently \"npm run watch:server\" \"npm run watch:plugin\"",
    "watch:server": "tsc -p tsconfig.server.json --watch",
    "watch:plugin": "esbuild plugin/code.ts --bundle --outfile=dist/plugin/code.js --target=es6 --format=iife --watch",
    "start": "node dist/server/index.js",
    "dev": "npm run build && npm run start",
    "lint": "eslint --ext .ts server/ plugin/",
    "lint:fix": "eslint --ext .ts server/ plugin/ --fix",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.27.2",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT"
}
